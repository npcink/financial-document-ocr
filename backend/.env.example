# ============================================
# 发票智能识别系统 — 环境变量配置示例
# 复制本文件为 .env 并按需修改
# ============================================

# 运行模式: cloud（云端 API）| local（本地 Ollama）
AI_MODE=cloud

# SiliconFlow 云端 API 配置
SILICONFLOW_API_KEY=your_api_key_here
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# 模型名称
OCR_MODEL_CLOUD=deepseek-ai/DeepSeek-OCR
LLM_MODEL_CLOUD=deepseek-ai/DeepSeek-V4-Flash
OCR_MODEL_LOCAL=glm-ocr:latest
LLM_MODEL_LOCAL=qwen3.5:0.8b

# Ollama 本地配置
OLLAMA_HOST=http://localhost:11434

# 并发配置
OCR_MAX_WORKERS_CLOUD=4      # 云端 OCR 服务侧保护并发
LLM_MAX_WORKERS_CLOUD=6      # 云端 LLM 服务侧保护并发
OCR_MAX_WORKERS_LOCAL=4
LLM_MAX_WORKERS_LOCAL=6

# 任务队列与超时
JOB_QUEUE_WORKERS=3          # 后台同时处理几个批量任务；OCR/LLM 总并发仍由上面的全局并发限制
MAX_ACTIVE_CHILDREN_PER_PARENT=1  # 同一个父批量任务最多同时运行几个子批次，避免大任务独占队列
JOB_TIMEOUT=7200             # 单个批量任务最长处理秒数
MAX_BATCH_FILES=20000        # 单个父批量任务最多文件数
CHILD_BATCH_SIZE=300         # 大任务拆分后的子批次大小
RESUMABLE_UPLOAD_CHUNK_SIZE=300

# 数据保留与后台清理
CLEANUP_HOURS=72
CLEANUP_INTERVAL=3600

# PDF 与上下文限制
PDF_OCR_CONCURRENCY=8
LLM_MAX_CONTEXT_CLOUD=8000
LLM_MAX_CONTEXT_LOCAL=6000
PRECLASSIFY_THRESHOLD=0.7

# SiliconFlow 限流配置示例；请按服务商公开限额和自己的账户策略调整
SILICONFLOW_OCR_RPM=1000
SILICONFLOW_LLM_RPM=500
SILICONFLOW_OCR_TPM=80000
SILICONFLOW_LLM_TPM=2000000
SILICONFLOW_CHAT_RPM=0
SILICONFLOW_MAX_RETRIES=5
SILICONFLOW_RETRY_DELAYS=5,15,45,120,240
